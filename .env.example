# Optional integrations. Keep real values in Render Environment or local .env only.
COMPANY_ENV=hosted
COMPANY_LOG_LEVEL=INFO

# AI providers. Gemini is primary (research roles also use Google Search grounding);
# Groq is an optional quota fallback.
GEMINI_API_KEY=
AI_COMPANY_GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Telegram: task intake + owner notifications (sales, mail, daily reports).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional; defaults to the first allowed chat ID.
TELEGRAM_OWNER_CHAT_ID=
# Run the Telegram intake inside the web service (no separate CLI process needed).
AI_COMPANY_EMBEDDED_TELEGRAM=false

# Autonomous daily/weekly work (prospect research, product scan, content drafts, weekly review).
AI_COMPANY_AUTO_TASKS=true

# Support mailbox. Use a DEDICATED mailbox (handled mails are flagged / marked seen).
# For Gmail use an app password with IMAP enabled.
AI_COMPANY_EMBEDDED_MAIL=false
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# draft = owner gets drafts on Telegram, nothing is sent (default).
# auto_reply = replies to inbound mail automatically (owner opt-in).
AI_COMPANY_MAIL_MODE=draft
MAIL_MAX_REPLIES_PER_DAY=20
MAIL_MAX_REPLIES_PER_SENDER_PER_DAY=2
# Owner-approved facts the assistant may state. Anything not here => "the owner will follow up".
MAIL_KNOWLEDGE=
MAIL_ALLOWED_LINK_PREFIXES=https://buymeacoffee.com/sevketkaynar

# Buy Me a Coffee membership activation. Configure only after creating the live $69/month tier.
BMC_WEBHOOK_SECRET=
BMC_PRO_MEMBERSHIP_LEVEL_ID=
BMC_PRO_PRICE_USD=69
BMC_PRO_CHECKOUT_URL=https://buymeacoffee.com/sevketkaynar

# Required for auto-reply mode: only trust the first Authentication-Results header from these mail gateways.
MAIL_TRUSTED_AUTH_SERVERS=mx.google.com

# Map BMC membership level IDs to approved product releases (set after product publication).
# Example: BMC_PRODUCT_LEVEL_MAP={"LEVEL_ID":{"product_id":"prd-...","price_usd":"30.00","product_code":"netcmd_pro","product_name":"NetCmd PRO"}}
BMC_PRODUCT_LEVEL_MAP=
BMC_PRO_PRODUCT_ID=
APP_PUBLIC_URL=https://ai-company-ferd.onrender.com
