# Optional integrations. Keep real values in .env only; never commit secrets.
COMPANY_ENV=local
COMPANY_LOG_LEVEL=INFO

# Telegram task intake. Use a dedicated bot token and your numeric chat ID(s).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional local AI model (Ollama); no cloud API key required.
AI_COMPANY_OLLAMA_URL=http://127.0.0.1:11434
AI_COMPANY_OLLAMA_MODEL=qwen2.5:7b

# Legacy placeholders for future providers; not used by the current local runner.
LLM_PROVIDER=
LLM_API_KEY=
