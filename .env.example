# Optional integrations. Keep real values in Render Environment or local .env only.
COMPANY_ENV=hosted
COMPANY_LOG_LEVEL=INFO

# Google Gemini 3.8 Flash is the only AI provider used by hosted agents.
GEMINI_API_KEY=
AI_COMPANY_GEMINI_MODEL=gemini-3.8-flash

# Telegram task intake. Use a dedicated bot token and your numeric chat ID(s).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Buy Me a Coffee membership activation. Configure only after creating the live $69/month tier.
BMC_WEBHOOK_SECRET=
BMC_PRO_MEMBERSHIP_LEVEL_ID=
BMC_PRO_PRICE_USD=69
BMC_PRO_CHECKOUT_URL=https://buymeacoffee.com/sevketkaynar
