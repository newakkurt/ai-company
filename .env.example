# Keep real values in Render Environment / GitHub Actions Secrets only.
COMPANY_ENV=hosted
COMPANY_LOG_LEVEL=INFO

# Hosted data and API gate (server-side only; never expose DB gate key to browsers).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_GATE_KEY=
AI_COMPANY_API_KEY=
AI_COMPANY_DB_PATH=/tmp/ai-company/company.db

# AI providers. When both keys exist, Gemini is primary and Groq is quota fallback. The current Actions worker uses Groq directly; Render API readiness is independent.
GEMINI_API_KEY=
AI_COMPANY_GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# auto = Gemini with Groq fallback; set groq or gemini to force one provider.
AI_COMPANY_PROVIDER=auto

# Tiered local-first routing (see docs/HARNESS.md). Off unless ROUTING=tiered or a LOCAL URL is set.
AI_COMPANY_ROUTING=
AI_COMPANY_LOCAL_SMALL_URL=
AI_COMPANY_LOCAL_SMALL_MODEL=
AI_COMPANY_LOCAL_LARGE_URL=
AI_COMPANY_LOCAL_LARGE_MODEL=
AI_COMPANY_ALLOW_CLOUD=true
AI_COMPANY_MEM_LIMIT_GB=32
AI_COMPANY_ALLOW_SHELL=false
AI_COMPANY_REVIEW_DB=
AI_COMPANY_TRACE_DIR=

# One worker consumer is preferred. GitHub Actions is the scheduled worker by default.
# Enable the embedded Render worker only if the Actions schedule is disabled.
AI_COMPANY_EMBEDDED_WORKER=false
AI_COMPANY_AUTO_TASKS=true

# Telegram: owner notifications and optional task intake.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_OWNER_CHAT_ID=
AI_COMPANY_EMBEDDED_TELEGRAM=false

# Dedicated support mailbox. Keep draft mode until the sender/authentication setup is verified.
AI_COMPANY_EMBEDDED_MAIL=false
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
AI_COMPANY_MAIL_MODE=draft
MAIL_MAX_REPLIES_PER_DAY=20
MAIL_MAX_REPLIES_PER_SENDER_PER_DAY=2
MAIL_KNOWLEDGE=
MAIL_ALLOWED_LINK_PREFIXES=https://buymeacoffee.com/sevketkaynar
MAIL_TRUSTED_AUTH_SERVERS=mx.google.com

# Buy Me a Coffee. Map each Shop item ID (extras[].id) to a published product release.
BMC_WEBHOOK_SECRET=
BMC_PRO_MEMBERSHIP_LEVEL_ID=
BMC_PRO_PRODUCT_ID=
BMC_PRO_PRICE_USD=69
BMC_PRO_CHECKOUT_URL=https://buymeacoffee.com/sevketkaynar
# Shop item map: {"EXTRA_ID":{"product_id":"prd-...","price_usd":"30.00","product_code":"netcmd_pro","product_name":"NetCmd PRO"}}
BMC_EXTRA_PRODUCT_MAP=
# Optional membership-tier map (not used for Shop Extras).
BMC_PRODUCT_LEVEL_MAP=
APP_PUBLIC_URL=https://ai-company-ferd.onrender.com
